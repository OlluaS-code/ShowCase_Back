{
  "name": "servidor_showcase",
  "version": "1.0.0",
  "main": "src/index.ts",
  "repository": "https://github.com/OlluaS-code/Olluas_ShowCase.git",
  "author": "Olluas-code",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src/index.ts",
    "check": "tsc --noEmit",
    "build": "tsc",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "lint": "biome check ./src",
    "lint:fix": "biome check --write ./src",
    "format": "biome format --write ./src",
    "test": "cross-env NODE_ENV=test vitest run",
    "test:watch": "cross-env NODE_ENV=test vitest",
    "db:sync": "cross-env NODE_ENV=development tsx -e \"import('./src/utils/settings/data-source').then(async m => { m.AppDataSource.setOptions({ synchronize: true }); await m.AppDataSource.initialize(); console.log('Tabelas sincronizadas com sucesso!'); process.exit(0); })\"",
    "db:seed": "cross-env NODE_ENV=development tsx scripts/seedMocks.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@testcontainers/postgresql": "^12.0.4",
    "@testcontainers/redis": "^12.0.4",
    "@tsconfig/node22": "^22.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^7.0.11",
    "@types/uuid": "^11.0.0",
    "cross-env": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "repomix": "^1.18.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "uuid": "^14.0.1",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^1.52.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/sse": "^0.5.0",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@sinclair/typebox": "^0.34.49",
    "ajv-formats": "^3.0.1",
    "argon2": "^0.44.0",
    "axios": "^1.13.6",
    "cors": "^2.8.6",
    "fastify": "^5.8.1",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "lru-cache": "10",
    "morgan": "^1.10.1",
    "nodemailer": "^8.0.1",
    "p-limit": "3.1.0",
    "pg": "^8.18.0",
    "reflect-metadata": "^0.2.2",
    "typebox": "^1.3.2",
    "typeorm": "^0.3.28"
  }
}
